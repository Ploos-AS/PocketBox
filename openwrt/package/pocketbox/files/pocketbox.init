#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

start_service() {
	local enabled root http_port terminal_port bind
	config_load pocketbox
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get root main root /mnt/pocketbox
	config_get bind main bind 127.0.0.1
	config_get http_port main http_port 8080
	config_get terminal_port main terminal_port 2323
	[ -d "$root" ] || { logger -t pocketbox "missing file root: $root"; return 1; }
	procd_open_instance
	procd_set_param command /usr/bin/pocketbox --bind "$bind" --root "$root" --http-port "$http_port" --telnet-port "$terminal_port"
	procd_set_param respawn
	procd_close_instance
}
